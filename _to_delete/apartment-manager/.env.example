# Copy to .env and adjust. All values have working defaults for local development.

APP_NAME="Haven PMS"
APP_ENV=development

# SQLite for local dev; swap for Postgres in production.
DATABASE_URL=sqlite:///./haven.db
# DATABASE_URL=postgresql+psycopg://haven:haven@localhost:5432/haven

# MUST be changed before deploying. Use at least 32 random bytes.
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=720

DEFAULT_CURRENCY=GBP
CORS_ORIGINS=*
