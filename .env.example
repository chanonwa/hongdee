# Copy to .env and adjust, then run: uvicorn backend.main:app --env-file .env
# (the app does not read .env on its own). All values have working defaults for local development.

APP_NAME="RentDee"
APP_ENV=development

# SQLite for local dev; swap for Postgres in production.
DATABASE_URL=sqlite:///./rentdee.db
# DATABASE_URL=postgresql+psycopg://rentdee:rentdee@localhost:5432/rentdee

# MUST be changed before deploying. Use at least 32 random bytes.
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=720

DEFAULT_CURRENCY=GBP
CORS_ORIGINS=*
